{
  "name": "kephale",
  "version": "0.0.1",
  "private": true,
  "description": "Kephale — Plateforme de streaming musical africaine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/update-ip.cjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "backend": "turbo run dev --filter=@kephale/backend",
    "mobile": "turbo run dev --filter=@kephale/mobile",
    "db:generate": "turbo run db:generate --filter=@kephale/database",
    "db:migrate": "turbo run db:migrate --filter=@kephale/database",
    "db:studio": "turbo run db:studio --filter=@kephale/database",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ajv": "^8.20.0",
    "bun": "^1.3.14",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@expo/config-plugins": "~54.0.5",
    "@prisma/client": "^6.19.3",
    "react-native-reanimated": "~4.1.1"
  }
}
