# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Kephale
FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kephale:kephale_dev@localhost:5432/kephale_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_change_in_prod
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── AWS S3 / Storage ─────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=kephale-media
S3_BUCKET_PUBLIC_URL=https://kephale-media.s3.eu-west-1.amazonaws.com
CDN_BASE_URL=https://cdn.kephale.app

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxx
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_xxxx

# ─── CinetPay (Mobile Money — Afrique de l'Ouest) ────────────────────────────────
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
# Réseaux supportés: Orange Money, Wave, MTN, Moov, Free Money, Carte Bancaire

# ─── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SERVER_URL=wss://your-project.livekit.cloud

# ─── Exchange Rates ────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=your_openexchangerates_key

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=noreply@kephale.app

# ─── Expo Push Notifications ──────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_access_token

# ─── Audio Fingerprint / Reconnaissance Musicale ──────────────────────
# Chromaprint CLI (fpcalc) — installé via: brew install chromaprint (macOS) / apt install libchromaprint-tools (Linux)
FPCALC_PATH=fpcalc

# ACRCloud — API de reconnaissance musicale professionnelle (https://www.acrcloud.com)
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com

# AudD — API de reconnaissance musicale fallback (https://audd.io)
AUDD_API_KEY=
