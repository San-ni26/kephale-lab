generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  googleId             String?              @unique
  email                String               @unique
  password             String?
  name                 String
  username             String               @unique
  avatar               String?
  role                 Role                 @default(LISTENER)
  tokenBalance         Int                  @default(0)
  country              String?
  phoneNumber          String?              @unique
  preferredCurrency    String               @default("EUR")
  pushToken            String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  artistProfile        ArtistProfile?
  comments             Comment[]
  conversationsAsUser1 Conversation[]       @relation("ConversationsUser1")
  conversationsAsUser2 Conversation[]       @relation("ConversationsUser2")
  copyrightReports     CopyrightReport[]    @relation("CopyrightReporter")
  copyrightStrikes     CopyrightStrike[]    @relation("CopyrightStrikes")
  discussionRequests   DiscussionRequest[]
  donationsSent        Donation[]
  follows              Follow[]
  likes                Like[]
  liveParticipations   LiveParticipant[]
  liveReports          LiveReport[]
  messagesSent         Message[]
  notifications        Notification[]
  downloads            OfflineDownload[]
  passwordResetTokens  PasswordResetToken[]
  purchases            Purchase[]
  refreshTokens        RefreshToken[]
  downloadAudits       DownloadAudit[]
  subscription         Subscription?
  affinities           UserArtistAffinity[]
  videoViews           UserVideoView[]
  reels                Video[]              @relation("UserReels")
  adCampaigns          AdCampaign[]
  tokenTransactions    TokenTransaction[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model ArtistProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  stageName       String               @unique
  bio             String?
  avatar          String?
  coverImage      String?
  genre           String[]
  country         String               @default("SN")
  websiteUrl      String?
  instagramUrl    String?
  twitterUrl      String?
  stripeAccountId String?
  isVerified      Boolean              @default(false)
  isActive        Boolean              @default(true)
  totalEarnings   Int                  @default(0)
  pendingPayout   Int                  @default(0)
  totalPlays      Int                  @default(0)
  totalViews      Int                  @default(0)
  totalFollowers  Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  albums          Album[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers       Follow[]
  lives           Live[]
  playlists       Playlist[]
  posts           Post[]
  tracks          Track[]
  affinities      UserArtistAffinity[]
  videos          Video[]
  withdrawals     Withdrawal[]

  @@index([stageName])
  @@map("artist_profiles")
}

model Follow {
  id           String        @id @default(cuid())
  userId       String
  artistId     String
  notifyAll    Boolean       @default(true)
  notifyAlbums Boolean       @default(true)
  notifyTracks Boolean       @default(true)
  notifyVideos Boolean       @default(true)
  createdAt    DateTime      @default(now())
  artist       ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@map("follows")
}

model UserArtistAffinity {
  id        String        @id @default(cuid())
  userId    String
  artistId  String
  score     Float         @default(0)
  updatedAt DateTime      @updatedAt
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
  @@map("user_artist_affinities")
}

model Album {
  id          String        @id @default(cuid())
  artistId    String
  title       String
  description String?
  coverUrl    String
  price       Int           @default(0)
  currency    String        @default("XOF")
  status      AlbumStatus   @default(ACTIVE)
  releaseDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  tracks      Track[]
  adCampaigns AdCampaign[]

  @@index([artistId])
  @@index([status])
  @@map("albums")
}

model Track {
  id               String            @id @default(cuid())
  artistId         String
  albumId          String?
  title            String
  duration         Int               @default(0)
  coverUrl         String            @default("")
  audioUrl         String            @default("")
  waveformData     Json?
  price            Int               @default(0)
  currency         String            @default("XOF")
  genre            String[]
  bpm              Int?
  key              String?
  plays            Int               @default(0)
  status           TrackStatus       @default(PROCESSING)
  s3Key            String?
  fingerprint      String?
  isExplicit       Boolean           @default(false)
  releaseDate      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  copyrightReports CopyrightReport[]
  likes            Like[]
  downloads        OfflineDownload[]
  playlistItems    PlaylistItem[]
  posts            Post[]
  purchases        Purchase[]
  downloadAudits   DownloadAudit[]
  album            Album?            @relation(fields: [albumId], references: [id])
  artist           ArtistProfile     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  reelsWithAudio   Video[]           @relation("VideoAudioTrack")
  adCampaigns      AdCampaign[]

  @@index([artistId])
  @@index([status])
  @@index([createdAt])
  @@index([fingerprint])
  @@map("tracks")
}

model Playlist {
  id          String         @id @default(cuid())
  artistId    String?
  userId      String?
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PlaylistItem[]
  artist      ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@map("playlist_items")
}

model Video {
  id                String            @id @default(cuid())
  artistId          String?
  userId            String?
  title             String
  description       String?
  type              VideoType
  thumbnailUrl      String
  videoUrl          String
  duration          Int
  price             Int               @default(0)
  currency          String            @default("EUR")
  views             Int               @default(0)
  status            VideoStatus       @default(PROCESSING)
  s3Key             String?
  isExplicit        Boolean           @default(false)
  audioTrackId      String?
  originalAudioName String?
  trimStart         Float?            @default(0)
  trimEnd           Float?
  audioVolume       Float?            @default(1.0)
  videoVolume       Float?            @default(1.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  comments          Comment[]
  copyrightReports  CopyrightReport[]
  copyrightStrikes  CopyrightStrike[]
  likes             Like[]
  posts             Post[]
  purchases         Purchase[]
  viewers           UserVideoView[]
  downloadAudits    DownloadAudit[]
  artist            ArtistProfile?    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  audioTrack        Track?            @relation("VideoAudioTrack", fields: [audioTrackId], references: [id])
  user              User?             @relation("UserReels", fields: [userId], references: [id], onDelete: Cascade)
  adCampaigns       AdCampaign[]

  @@index([artistId])
  @@index([type])
  @@index([status])
  @@index([status, type, createdAt])
  @@index([views])
  @@map("videos")
}

model UserVideoView {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@map("user_video_views")
}

model Post {
  id        String        @id @default(cuid())
  artistId  String
  type      PostType
  content   String?
  mediaUrl  String?
  trackId   String?
  videoId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  comments  Comment[]
  likes     Like[]
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  track     Track?        @relation(fields: [trackId], references: [id])
  video     Video?        @relation(fields: [videoId], references: [id])

  @@index([artistId])
  @@index([createdAt])
  @@map("posts")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  trackId   String?
  videoId   String?
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  track     Track?   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, trackId])
  @@unique([userId, videoId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  videoId   String?
  content   String
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([videoId])
  @@map("comments")
}

model Live {
  id                 String              @id @default(cuid())
  artistId           String
  title              String
  description        String?
  thumbnailUrl       String?
  roomId             String              @unique
  status             LiveStatus          @default(SCHEDULED)
  mode               LiveMode            @default(VIDEO)
  allowGuests        Boolean             @default(true)
  maxGuests          Int                 @default(5)
  duration           Int?
  likesCount         Int                 @default(0)
  viewerCount        Int                 @default(0)
  viewerPeak         Int                 @default(0)
  totalTokens        Int                 @default(0)
  scheduledAt        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  recordingUrl       String?
  createdAt          DateTime            @default(now())
  discussionRequests DiscussionRequest[]
  donations          Donation[]
  chatMessages       LiveChatMessage[]
  participants       LiveParticipant[]
  reports            LiveReport[]
  artist             ArtistProfile       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([status])
  @@map("lives")
}

model LiveChatMessage {
  id         String   @id @default(cuid())
  liveId     String
  userId     String
  userName   String
  userAvatar String?
  message    String
  createdAt  DateTime @default(now())
  live       Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId])
  @@index([createdAt])
  @@map("live_chat_messages")
}

model Donation {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  tokens    Int
  message   String?
  createdAt DateTime @default(now())
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([liveId])
  @@map("donations")
}

model DiscussionRequest {
  id        String           @id @default(cuid())
  liveId    String
  userId    String
  status    DiscussionStatus @default(PENDING)
  roomId    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  live      Live             @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@index([liveId])
  @@map("discussion_requests")
}

model LiveParticipant {
  id        String                @id @default(cuid())
  liveId    String
  userId    String
  status    LiveParticipantStatus @default(PENDING)
  isMuted   Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  live      Live                  @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id])

  @@unique([liveId, userId])
  @@map("live_participants")
}

model LiveReport {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([liveId])
  @@map("live_reports")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  paidStreamsUsed      Int                @default(0)
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model TokenPack {
  id            String   @id @default(cuid())
  tokens        Int
  priceEur      Float
  label         String
  isBestValue   Boolean  @default(false)
  isActive      Boolean  @default(true)
  stripePriceId String?
  createdAt     DateTime @default(now())

  @@map("token_packs")
}

model Purchase {
  id                    String          @id @default(cuid())
  userId                String
  type                  PurchaseType
  trackId               String?
  videoId               String?
  albumId               String?
  amount                Int
  currency              String
  platformFeePercent    Float           @default(20)
  platformFeeAmount     Int
  artistAmount          Int
  provider              PaymentProvider
  stripePaymentIntentId String?
  cinetpayTransactionId String?
  externalPaymentId     String?
  status                String          @default("SUCCEEDED")
  createdAt             DateTime        @default(now())
  album                 Album?          @relation(fields: [albumId], references: [id])
  track                 Track?          @relation(fields: [trackId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])
  video                 Video?          @relation(fields: [videoId], references: [id])

  @@index([userId])
  @@index([trackId])
  @@index([videoId])
  @@index([albumId])
  @@map("purchases")
}

model Withdrawal {
  id             String           @id @default(cuid())
  artistId       String
  amount         Int
  currency       String           @default("XOF")
  status         WithdrawalStatus @default(PENDING)
  paymentMethod  String?
  paymentDetails String?
  reference      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  artist         ArtistProfile    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@map("withdrawals")
}

model OfflineDownload {
  id               String   @id @default(cuid())
  userId           String
  trackId          String
  encryptionKeyRef String
  licenseExpiresAt DateTime
  downloadedAt     DateTime @default(now())
  lastAccessedAt   DateTime @default(now())
  track            Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@map("offline_downloads")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model Conversation {
  id             String             @id @default(cuid())
  user1Id        String
  user2Id        String
  status         ConversationStatus @default(PENDING)
  expiresAt      DateTime?
  user1DeletedAt DateTime?
  user2DeletedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user1          User               @relation("ConversationsUser1", fields: [user1Id], references: [id])
  user2          User               @relation("ConversationsUser2", fields: [user2Id], references: [id])
  messages       Message[]

  @@unique([user1Id, user2Id])
  @@map("conversations")
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isDeleted      Boolean         @default(false)
  attachmentUrl  String?
  attachmentType AttachmentType?
  attachmentName String?
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model CopyrightReport {
  id         String           @id @default(cuid())
  reporterId String
  videoId    String
  trackId    String
  reason     String?
  status     String           @default("PENDING")
  adminNotes String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reporter   User             @relation("CopyrightReporter", fields: [reporterId], references: [id])
  track      Track            @relation(fields: [trackId], references: [id])
  video      Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  strike     CopyrightStrike?

  @@unique([reporterId, videoId])
  @@index([status])
  @@index([videoId])
  @@map("copyright_reports")
}

model CopyrightStrike {
  id        String          @id @default(cuid())
  userId    String
  reportId  String          @unique
  videoId   String
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  report    CopyrightReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User            @relation("CopyrightStrikes", fields: [userId], references: [id])
  video     Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@map("copyright_strikes")
}

enum Role {
  LISTENER
  PREMIUM
  PREMIUM_PLUS
  ARTIST
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum TrackStatus {
  PROCESSING
  ACTIVE
  INACTIVE
}

enum VideoType {
  CLIP
  SHORT
}

enum VideoStatus {
  PROCESSING
  ACTIVE
  INACTIVE
}

enum PostType {
  TRACK
  CLIP
  SHORT
  TEXT
  IMAGE
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum LiveMode {
  VIDEO
  AUDIO
}

enum LiveParticipantStatus {
  PENDING
  ACCEPTED
  REJECTED
  KICKED
}

enum DiscussionStatus {
  PENDING
  ACCEPTED
  REJECTED
  ENDED
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  STRIPE
  FLUTTERWAVE
  CINETPAY
  DPO
  ORANGE_MONEY
  MTN_MOBILE_MONEY
  WAVE
  MPESA
  TOKEN
}

enum PurchaseType {
  TRACK
  CLIP
  ALBUM
  TOKEN_PACK
  SUBSCRIPTION
}

enum AlbumStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

// ─── AD SERVER & REGIE PUBLICITAIRE ─────────────────────────────────────────

enum AdPlacement {
  REEL
  CLIP_PREROLL
  BANNER
  AUDIO_SPOT
  TRACK_BOOST
  ALBUM_BOOST
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Advertiser {
  id           String       @id @default(cuid())
  name         String
  company      String?
  contactEmail String?
  contactPhone String?
  notes        String?
  campaigns    AdCampaign[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("advertisers")
}

model AdCampaign {
  id                 String         @id @default(cuid())
  advertiserId       String?
  advertiser         Advertiser?    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  trackId            String?
  track              Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  albumId            String?
  album              Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  videoId            String?
  video              Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  title              String
  placement          AdPlacement    @default(REEL)
  mediaUrl           String
  thumbnailUrl       String?
  targetUrl          String
  ctaText            String         @default("En savoir plus")
  targetCountries    String[]       @default([])
  startDate          DateTime
  endDate            DateTime
  maxImpressions     Int?
  currentImpressions Int            @default(0)
  currentClicks      Int            @default(0)
  costTokens         Int?           @default(0)
  boostPackage       String?
  status             AdStatus       @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  impressions        AdImpression[]
  clicks             AdClick[]
  tokenTransactions  TokenTransaction[]

  @@index([status, placement])
  @@index([userId])
  @@index([trackId])
  @@index([albumId])
  @@index([videoId])
  @@index([startDate, endDate])
  @@map("ad_campaigns")
}

model AdImpression {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String?
  country    String?
  device     String?
  watched100 Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([campaignId, createdAt])
  @@map("ad_impressions")
}

model AdClick {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String?
  country    String?
  device     String?
  createdAt  DateTime   @default(now())

  @@index([campaignId, createdAt])
  @@map("ad_clicks")
}

enum TokenTransactionType {
  PURCHASE_PACK     // Bought tokens with Fiat (CinetPay/Stripe)
  SPEND_CONTENT     // Bought Track, Album, Video with tokens
  SPEND_BOOST       // Paid for Ad / Self-serve Boost
  SPEND_GIFT        // Donated tokens in Live
  EARN_CONTENT      // Artist earned tokens/revenue
  EARN_GIFT         // Artist received donation in Live
  ADMIN_ADJUST      // Admin credited or debited tokens
  REFUND            // Refunded tokens
}

model TokenTransaction {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int                  // Positive for credit (+), Negative for debit (-)
  type         TokenTransactionType
  description  String
  balanceAfter Int
  campaignId   String?
  campaign     AdCampaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  purchaseId   String?
  metadata     Json?
  createdAt    DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("token_transactions")
}

// ── Audit Trail des Téléchargements ──────────────────────────────────────────
// SÉCURITÉ : Chaque téléchargement offline est enregistré pour :
// - Audit de conformité DRM
// - Détection d'abus (téléchargements massifs)
// - Traçabilité légale en cas de violation de copyright
model DownloadAudit {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId     String?
  track       Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  videoId     String?
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  ipAddress   String    @default("")
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([trackId])
  @@index([videoId])
  @@map("download_audits")
}
